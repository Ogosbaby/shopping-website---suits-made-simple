# ---------------------------------------------------------------------------
# Suits Made Simple — environment variables
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only key used for cart + order writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Settings -> API Keys & Webhooks). Amounts are charged in NGN.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if you build an inline payment form; the hosted checkout does not use it.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailgun (Sending -> Domains -> your domain)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM="Suits Made Simple <postmaster@mg.yourdomain.com>"
# Use https://api.eu.mailgun.net for EU-region domains
MAILGUN_BASE_URL=https://api.mailgun.net

# Public site URL (used in the confirmation email and OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
